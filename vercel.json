{
  "crons": [
    {
      "path": "/api/auditor",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/view-count-sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/brand-scraper",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/channel-discovery",
      "schedule": "0 6 * * 0,4"
    },
    {
      "path": "/api/creator-scout",
      "schedule": "0 9 * * 3"
    },
    {
      "path": "/api/campaign-scanner",
      "schedule": "0 8 * * 2"
    },
    {
      "path": "/api/creator-matcher",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/adsense-monthly",
      "schedule": "0 7 5 * *"
    },
    {
      "path": "/api/subplot?path=__health",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/roster-warm",
      "schedule": "*/10 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/apply",
      "has": [
        {
          "type": "host",
          "value": "subplot.digitalfoxtalent.com"
        }
      ],
      "destination": "/api/apply"
    },
    {
      "source": "/api/apply",
      "has": [
        {
          "type": "host",
          "value": "subplot.tv"
        }
      ],
      "destination": "/api/apply"
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "subplot.digitalfoxtalent.com"
        }
      ],
      "destination": "/api/subplot?path=:path"
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "subplot.tv"
        }
      ],
      "destination": "/api/subplot?path=:path"
    },
    {
      "source": "/api/apply",
      "has": [
        {
          "type": "host",
          "value": "wordie.media"
        }
      ],
      "destination": "/api/apply"
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "wordie.media"
        }
      ],
      "destination": "/api/subplot?path=:path"
    },
    {
      "source": "/subplot/api/apply",
      "destination": "/api/apply"
    },
    {
      "source": "/subplot",
      "destination": "/api/subplot?base=subplot"
    },
    {
      "source": "/subplot/:path*",
      "destination": "/api/subplot?path=:path*&base=subplot"
    },
    {
      "source": "/campaigns",
      "has": [
        {
          "type": "host",
          "value": "roster-viewguarantee.digitalfoxtalent.com"
        }
      ],
      "destination": "/api/reports?r=campaigns"
    },
    {
      "source": "/:path((?!api/|_vercel/).*)",
      "has": [
        {
          "type": "host",
          "value": "reports.digitalfoxtalent.com"
        }
      ],
      "destination": "/api/reports?r=:path"
    },
    {
      "source": "/",
      "destination": "/roster.html",
      "has": [
        {
          "type": "host",
          "value": "roster-viewguarantee.digitalfoxtalent.com"
        }
      ]
    },
    {
      "source": "/roster.html",
      "destination": "/roster.html",
      "has": [
        {
          "type": "host",
          "value": "roster-viewguarantee.digitalfoxtalent.com"
        }
      ]
    },
    {
      "source": "/api/apply",
      "destination": "/api/apply"
    },
    {
      "source": "/:path((?!api/|_vercel/).*)",
      "destination": "/api/subplot?path=:path"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "subplot.digitalfoxtalent.com"
        }
      ],
      "destination": "https://subplot.tv/:path*",
      "permanent": true
    }
  ]
}
